Group {
 name Lens_Edge_Extend2
 tile_color 0x2b6cb0ff
 note_font " Bold"
 note_font_size 14
 note_font_color 0xffd166ff
 addUserKnob {20 User}
 addUserKnob {22 Reset l "all Settings Reset" T "import nuke\n\nn = nuke.thisNode()\n\n# Label shown in the panel -> value to reset to\ndefaults = \{\n    \"Lens\"              : \"Alpha\",\n    \"Use Lens as Matte\" : False,\n    \"Blur Lens\"         : 6,\n    \"Lens Size\"         : 3,\n    \"Lens Multiplier\"   : 1,\n    \"Distortion Amount\" : -4,\n    \"Distort Alpha\"     : False,\n    \"Distort Chroma\"    : False,\n    \"Chroma Separation\" : 0,\n\}\n\n# If you know the inner knob for Blur Lens, type it here (e.g. \"Blur1.size\")\n# Leave as None to auto-detect from the link.\nBLUR_LENS_TARGET = None\n\nby_label = \{\}\nfor name, k in n.knobs().items():\n    lbl = k.label()\n    if lbl and lbl.strip() not in by_label:\n        by_label\[lbl.strip()] = k\n\n\ndef find_inner_node(node_name):\n    \"\"\"Look for a node inside this group, then at root, then by full path.\"\"\"\n    with n:\n        t = nuke.toNode(node_name)\n    if t is None:\n        t = nuke.toNode(node_name)\n    if t is None:\n        t = nuke.toNode(n.fullName() + \".\" + node_name)\n    return t\n\n\ndef resolve(k, forced=None):\n    \"\"\"Return the real knob behind a Link_Knob (or the knob itself).\"\"\"\n    link = forced\n    if link is None and k.Class() == \"Link_Knob\":\n        try:\n            link = k.getLink()\n        except Exception:\n            link = None\n    if not link:\n        return k\n    if \".\" in link:\n        node_name, knob_name = link.rsplit(\".\", 1)\n        t = find_inner_node(node_name)\n        if t is not None and t.knob(knob_name):\n            return t.knob(knob_name)\n    elif n.knob(link):\n        return n.knob(link)\n    print(\"Link '%s' could not be resolved\" % link)\n    return k\n\n\ndef set_all(real, value):\n    real.clearAnimated()\n    real.setValue(value)                       # sets all values\n    size = real.arraySize()\n    if size > 1:                               # make sure every index matches\n        vals = \[real.value(i) for i in range(size)]\n        if any(v != value for v in vals):\n            for i in range(size):\n                real.setValue(value, i)\n\n\ndef read(real):\n    try:\n        size = real.arraySize()\n        return \[real.value(i) for i in range(size)] if size > 1 else real.value()\n    except Exception:\n        return real.value()\n\n\nmissing = \[]\n\nundo = nuke.Undo()\nundo.begin(\"Reset Lens_Edge_Extend\")\ntry:\n    for label, value in defaults.items():\n        k = by_label.get(label)\n        if k is None:\n            missing.append(label)\n            continue\n        try:\n            forced = BLUR_LENS_TARGET if label == \"Blur Lens\" else None\n            real = resolve(k, forced)\n            old = read(real)\n            set_all(real, value)\n            print(\"%s | panel knob: %s | real knob: %s.%s (%s) | %s -> %s\" % (\n                label, k.Class(), real.node().name(), real.name(),\n                real.Class(), old, read(real)))\n        except Exception as e:\n            print(\"Could not reset '%s' (%s): %s\" % (label, k.Class(), e))\nfinally:\n    undo.end()\n\nif missing:\n    nuke.message(\"Reset done, but these knobs were not found:\\n\\n\" + \"\\n\".join(missing))\nelse:\n    print(\"%s: all settings reset.\" % n.name())" +STARTLINE}
 addUserKnob {4 lensChoice l Lens M {Alpha Luma}}
 addUserKnob {6 matte l "Use Lens as Matte" t "Mattes distortion to only where the lens is." +STARTLINE}
 addUserKnob {41 size l "Blur Lens" T Blur2.size}
 addUserKnob {7 strength l "Lens Size" R 0 100}
 strength 3
 addUserKnob {7 dispMult l "Lens Multiplier" R 1 100}
 dispMult 1
 addUserKnob {7 amt l "Distortion Amount" R -100 100}
 amt -4
 addUserKnob {6 barf l "Distort Alpha" +STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {6 distChrma l "Distort Chroma" +STARTLINE}
 addUserKnob {7 ChrmSep l "Chroma Separation" R -10 10}
 addUserKnob {26 credit_div l "" +STARTLINE}
 addUserKnob {26 credit l "" +STARTLINE T "<font color='#ff5f6d'><b>L</b></font><font color='#ffc371'><b>e</b></font><font color='#fff36b'><b>n</b></font><font color='#7bd88f'><b>s</b></font>&nbsp;<font color='#2ec4ff'><b>E</b></font><font color='#8e7dff'><b>d</b></font><font color='#ff6bd6'><b>g</b></font><font color='#ff5f6d'><b>e</b></font>&nbsp;<font color='#ffc371'><b>E</b></font><font color='#fff36b'><b>x</b></font><font color='#7bd88f'><b>t</b></font><font color='#2ec4ff'><b>e</b></font><font color='#8e7dff'><b>n</b></font><font color='#ff6bd6'><b>d</b></font> &nbsp;<font color='#8a8a8a'>by</font>&nbsp; <font color='#ff5f6d'><b>N</b></font><font color='#ffc371'><b>i</b></font><font color='#fff36b'><b>t</b></font><font color='#7bd88f'><b>i</b></font><font color='#2ec4ff'><b>n</b></font>&nbsp;<font color='#8e7dff'><b>K</b></font><font color='#ff6bd6'><b>a</b></font><font color='#ff5f6d'><b>s</b></font><font color='#ffc371'><b>h</b></font><font color='#fff36b'><b>y</b></font><font color='#7bd88f'><b>a</b></font><font color='#2ec4ff'><b>p</b></font> &nbsp;<font color='#ffd166'>v2.0 &bull; 2026</font>"}
 addUserKnob {22 about_btn l "About / Splash" -STARTLINE T "import nuke\ntry:\n    import nk_credit\n    nk_credit.show_splash()\nexcept ImportError:\n    nuke.message('Lens Edge Extend v2.0\\n\\nCreated by Nitin Kashyap')\n"}
}
